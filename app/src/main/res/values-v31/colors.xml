<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ widget colors: Material You system palettes (user-chosen accent
     and neutral tones), referenced by the widget layouts/backgrounds. The base
     values/colors.xml holds the dark brand fallback for API 26-30. -->
<resources>
    <color name="widget_card_bg">@android:color/system_neutral1_900</color>
    <color name="widget_card_stroke">@android:color/system_neutral1_700</color>
    <color name="widget_count">@android:color/system_neutral1_100</color>
    <color name="widget_count_reached">@android:color/system_accent1_400</color>
    <color name="widget_progress_track">@android:color/system_neutral1_700</color>
    <color name="widget_progress_fill">@android:color/system_accent1_400</color>
    <color name="widget_nm_label">@android:color/system_neutral1_400</color>
    <color name="widget_reset_text">@android:color/system_accent1_400</color>
    <color name="widget_copy_text">@android:color/system_accent1_400</color>
</resources>
