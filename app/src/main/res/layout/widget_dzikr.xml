<?xml version="1.0" encoding="utf-8"?>
<!-- Widget root, 100% stock views only: OEM launchers refuse to inflate
     custom view classes or custom font resources inside RemoteViews
     ("can't display widget"). The fade-in is produced by the provider via two
     RemoteViews applies (setAlpha 0 -> 1). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_dhikr_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
</FrameLayout>
