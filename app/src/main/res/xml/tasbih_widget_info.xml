<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen tasbih widget. updatePeriodMillis=0: no system-driven
     refresh; the provider re-renders on APPWIDGET_UPDATE and whenever a tap
     or reset changes the shared tasbih store. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_tasbih"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
