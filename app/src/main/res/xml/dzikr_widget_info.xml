<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget showing the rotating random dhikr (same cadence and
     fade as the Home tab). updatePeriodMillis=0: rotation is driven by the
     provider's own self-scheduling alarms, not by the system period. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="55dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_dzikr"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
