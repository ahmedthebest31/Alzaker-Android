<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark pill behind the widget dhikr text, matching the AudioOverlay
     look (dark translucent fill + faint white border). The colors are
     version-qualified (@color/widget_card_bg/_stroke): API 31+ resolves them
     to Material You system colors, API 26-30 keep this dark brand fallback. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card_bg" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_card_stroke" />
</shape>
