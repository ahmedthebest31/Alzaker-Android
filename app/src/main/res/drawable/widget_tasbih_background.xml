<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card behind the tasbih widget, mirroring the dhikr widget pill.
     The colors are version-qualified (@color/widget_card_bg/_stroke) so API 31+
     resolves them to Material You system colors while API 26-30 get the dark
     brand fallback. Stock shape only: OEM launchers refuse custom drawables
     classes inside RemoteViews. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card_bg" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_card_stroke" />
</shape>
