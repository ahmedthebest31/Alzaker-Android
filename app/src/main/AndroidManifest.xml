<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions mirror the published legacy Expo app (app.json android.permissions
        plus the defaults the RN/Expo template always ships):
        - VIBRATE, RECEIVE_BOOT_COMPLETED, FOREGROUND_SERVICE,
          FOREGROUND_SERVICE_MEDIA_PLAYBACK, POST_NOTIFICATIONS are the explicit
          legacy list.
        - INTERNET is the RN/Expo default; needed for remote audio_url streaming
          (decision D5) replicated in the dhikr audio overlay.
        - USE_EXACT_ALARM is declared for OEM compat (note N2); the scheduler
          falls back to setAndAllowWhileIdle when canScheduleExactAlarms() is false.
        - WAKE_LOCK keeps the device awake while an audio drop plays in the
          foreground service.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        VIBRATE_ALWAYS (added in API 33, normal level, auto-granted) lets the
        app vibrate while in the background. The tasbih widget tap is handled
        by a BroadcastReceiver in the app process while the app is backgrounded,
        and Android 13+ otherwise suppresses background vibrations entirely.
    -->
    <uses-permission
        android:name="android.permission.VIBRATE_ALWAYS"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AlzakerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ReminderReceiver is targeted directly by an explicit-class
            PendingIntent (AlarmSchedulerImpl.buildPendingIntent), so it needs no
            intent-filter and stays non-exported.
        -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- Re-schedules enabled reminder chains after reboot / app update. -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".reminder.AudioReminderService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            DhikrAudioService is the dhikr media player: a foreground
            mediaPlayback service so playback continues with the screen locked
            or the app dismissed, with media controls in the notification shade
            and on the lock screen (media session). Started from the audio
            cards / overlay in the foreground; never exported.
        -->
        <service
            android:name=".audio.DhikrAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Home-screen dhikr widget: rotates a uniform random dhikr with the
            home-screen cadence (HomeRotation) and a stock-views fade (two
            driven by self-scheduling setAndAllowWhileIdle alarms. Exported=true
            is required for an appwidget provider: the system/launcher delivers
            APPWIDGET_UPDATE to it. BOOT_COMPLETED / MY_PACKAGE_REPLACED let the
            widget resume rotating after a reboot or an app update.
        -->
        <receiver
            android:name=".ui.widget.DhikrWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dzikr_widget_info" />
        </receiver>

        <!--
            Home-screen tasbih widget: renders the shared tasbih count/goal and
            mirrors the tasbih tab (same store, same haptics, system colors).
            The provider renders the card; a tap on it is a broadcast to
            TasbihWidgetReceiver (explicit-class PendingIntent, so it is
            non-exported) which increments the store with the app's haptics.
            BOOT_COMPLETED / MY_PACKAGE_REPLACED re-render after a reboot or an
            app update.
        -->
        <receiver
            android:name=".ui.widget.TasbihWidgetProvider"
            android:exported="true"
            android:label="@string/widget_tasbih_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasbih_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.TasbihWidgetReceiver"
            android:exported="false" />

        <!--
            Confirmation dialog for the tasbih widget's reset button (widget
            long-press is owned by the launcher, so reset is a small button
            that opens this dialog activity). Non-exported and kept out of
            recents.
        -->
        <activity
            android:name=".ui.widget.TasbihResetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.App.Dialog" />
    </application>

</manifest>
